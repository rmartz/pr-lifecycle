# Explicit default (base) registry = npmjs. Dependabot runs pnpm 11.8+, which —
# unlike npm — does NOT fall back across registries. Without this base pin it
# resolves every public dep against GitHub Packages, 404s, and silently proposes
# no update (dependabot-core#15415). Keep it alongside the scoped entry below.
registry=https://registry.npmjs.org/
# @rmartz/* packages (e.g. the @rmartz/repo-hygiene pre-commit CLI) publish to
# GitHub Packages. `pnpm install` must authenticate: set NODE_AUTH_TOKEN in the
# environment (locally: `NODE_AUTH_TOKEN=$(gh auth token) pnpm install`; in CI the
# setup action passes the job's GITHUB_TOKEN, which needs `packages: read`).
@rmartz:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
