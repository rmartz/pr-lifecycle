{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Build-only config consumed by tsup (tsup.config.ts): the package source alone,
  // emitting ESM + declarations to dist/. Type-checking uses tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
